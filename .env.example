# Local storage + deterministic replay work without credentials.
DAVINCI_MODE=replay
DAVINCI_DATA_DIR=runtime
MONGODB_URI=
MONGODB_DATABASE=da_vinci
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
DAVINCI_SANDBOX_IMAGE=da-vinci-cad:local
DAVINCI_RUN_BUDGET_USD=10
DAVINCI_DAILY_BUDGET_USD=50
DAVINCI_API_TOKEN=
DAVINCI_WEB_URL=http://127.0.0.1:3215
DAVINCI_API_URL=http://127.0.0.1:8215
# Atlas uses Database Triggers, plus reconciliation for missed events.
DAVINCI_USE_ATLAS_TRIGGERS=false
